@model Cinema.Models.DatabaseClasses.Movie
@{
    ViewData["Title"] = Model.Name;
}

<div class="container py-4">
    <div class="row g-4 align-items-start">

        <!-- Левая колонка1: постер -->
        <div class="col-12 col-md-4 text-center">
            <img src="~/images/@Model.PosterPath"
                 alt="@Model.Name Poster"
                 class="img-fluid rounded shadow-sm w-100"
                 style="max-height: 550px; object-fit: cover;">
        </div>

        <!-- Правая колонка1: информация -->
        <div class="col-12 col-md-8">

            <!-- Название -->
            <h1 class="fw-bold mb-4">@Model.Name</h1>

            <!-- Трейлер -->
            @if (!string.IsNullOrEmpty(Model.TrailerPath))
            {
                <div class="ratio ratio-16x9 mb-4">
                    <iframe src="@(Model.TrailerPath.Contains("?")
                                                                    ? Model.TrailerPath + "&autoplay=1"
                                                                    : Model.TrailerPath + "?autoplay=1")"
                        title="Трейлер @Model.Name"
                        allowfullscreen
                        allow="autoplay; encrypted-media"
                        class="rounded shadow-sm border-0"></iframe>
            </div>
                        }           
        </div>









        <!-- Левая колонка2: постер -->
        <div class="col-12 col-md-4 text-center">
            @{
                for (int i = 0; i < ViewBag.Screening.Count; i++)
                {
                    <button class="btn btn-info p-1 m-1" onclick="function1('@ViewBag.Screening[i].BeginningTime')"> @ViewBag.Screening[i].BeginningTime </button>
                }
            }
        </div>

        <!-- Правая колонка2: информация -->
        <div class="col-12 col-md-8">            
            <!-- Остальная информация -->
            <div class="mb-2 text-muted">
                <span class="me-3">
                    <i class="bi bi-clock"></i> @Model.Timing.ToString(@"hh\:mm")
                </span>

                <span class="fw-bold border bg-danger text-white px-2 py-1 rounded">
                    <i class="bi bi-person-badge"></i> @Model.AgeLimit?.Value+
                </span>
            </div>
            <hr />
            <!-- Жанры -->
            <div class="mb-3">
                <h5 class="fw-semibold">Жанры:</h5>
                @if (Model.Genres != null && Model.Genres.Any())
                {
                    <ul class="list-inline">
                        @foreach (var genre in Model.Genres)
                        {
                            <li class="list-inline-item badge bg-primary me-1 mb-1">@genre.Name</li>
                        }
                    </ul>
                }
                else
                {
                    <span class="text-muted">Жанры не указаны</span>
                }
            </div>
            <!-- Локализации -->
            <div class="mb-3">
                <h5 class="fw-semibold">Локализации:</h5>
                @if (Model.Localisations != null && Model.Localisations.Any())
                {
                    <ul class="list-inline">
                        @foreach (var loc in Model.Localisations)
                        {
                            <li class="list-inline-item badge bg-secondary me-1 mb-1">@loc.Name</li>
                        }
                    </ul>
                }
                else
                {
                    <span class="text-muted">Нет данных</span>
                }
            </div>
            <!-- Описание -->
            <div class="mt-4">
                <h5 class="fw-semibold mb-2">Описание:</h5>
                <p class="lead">@Model.Description</p>
            </div>
        </div>
    </div>
</div>
