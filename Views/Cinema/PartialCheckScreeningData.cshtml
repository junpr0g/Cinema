@model global::Cinema.Models.DatabaseClasses.MovieScreening
@using global::Cinema.Models.DatabaseClasses
@{
    List<Reserved> reserveds = ViewBag.Reserved;
    var reservedIds = reserveds.Select(r => r.PlaceId).ToHashSet();

    // Подготовим JS-данные
    var hallData = Model.Hall.Rows
        .OrderBy(r => r.RowNumber)
        .Select(r => new
        {
            RowNumber = r.RowNumber,
            Places = r.Places.OrderBy(p => p.PlaceNumber)
                .Select(p => new
                {
                    p.Id,
                    p.PlaceNumber,
                    p.VIP,
                    IsReserved = reservedIds.Contains(p.Id)
                })
        });
}

<div class="container-fluid text-light">
    <h4 class="mb-3">Зал №@Model.Hall.Number</h4>
    <p><strong>Начало:</strong> @Model.BeginningTime.ToString("dd.MM.yyyy HH:mm")</p>
    <p><strong>Цена билета:</strong> @Model.Price ₽</p>

    <hr class="border-secondary" />

    <div class="screen text-center mb-3">
        <div class="bg-secondary text-dark fw-bold rounded-pill py-1">ЭКРАН</div>
    </div>

    <div class="d-flex justify-content-center">
        <canvas id="hallCanvas"
                width="600"
                height="400"
                class="border border-secondary rounded w-100"
                data-hall='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(hallData))'
                style="max-width:600px;"></canvas>
    </div>

    <hr class="border-secondary mt-4" />

    <div class="legend d-flex gap-3 justify-content-center">
        <div><span class="badge bg-success">&nbsp;&nbsp;</span> Свободно</div>
        <div><span class="badge bg-secondary">&nbsp;&nbsp;</span> Занято</div>
        <div><span class="badge bg-warning text-dark">&nbsp;&nbsp;</span> VIP</div>
    </div>
</div>
