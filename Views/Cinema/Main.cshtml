@model List<Cinema.Models.DatabaseClasses.MovieRental>
<div class="container-fluid">
    <div class="row">
       @for (int i = 0; i < Model.Count; i++)
        {
            <div class="col-4">
                <div>@Model[i].Movie.Name</div>
                <div>@Model[i].Movie.Description</div>
                <div>@Model[i].Movie.Timing</div>
                <img src="~/images/@Model[i].Movie.PosterPath" />
            </div>
        }
    </div>
</div>