@model IEnumerable<Cinema.Models.DTOs.TicketDto>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning">
        Билеты не найдены.
    </div>
}
else
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">

                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title">
                            @item.Movie
                        </h5>

                        <p class="card-text">
                            Место:
                            <strong>@item.Place</strong>

                            @if (item.IsVip)
                            {
                                <span class="badge bg-warning text-dark ms-2">
                                    VIP
                                </span>
                            }
                        </p>

                        <p class="card-text">
                            Билет:
                            <strong>@item.TicketId</strong>
                        </p>

                        @if (!string.IsNullOrEmpty(item.PdfBase64))
                        {
                            <div class="mb-3" style="height:360px;">
                                <iframe src="data:application/pdf;base64,@item.PdfBase64"
                                        style="width:100%; height:100%; border:0;"
                                        title="ticket">
                                </iframe>
                            </div>

                            <div class="mt-auto">
                                <a class="btn btn-primary btn-sm"
                                   href="data:application/pdf;base64,@item.PdfBase64"
                                   download="ticket_@(item.TicketId).pdf">Скачать PDF
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-secondary">
                                PDF недоступен
                            </div>
                        }

                    </div>

                </div>
            </div>
        }
    </div>
}